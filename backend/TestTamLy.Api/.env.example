# ================================================================
# Biến môi trường cho TestTamLy.Api — COPY file này thành .env
# KHÔNG commit .env vào Git (đã có trong .gitignore)
# ================================================================

# Firebase Project ID (lấy từ Firebase Console → Project Settings)
FIREBASE_PROJECT_ID=testtamlydata

# URL backend lắng nghe (mặc định dev — thống nhất với launchSettings.json
# profile "http" và Classes/KetNoi.cs của WinForms)
ASPNETCORE_URLS=http://localhost:5296

# ----------------------------------------------------------------
# Xác thực (ADC — Application Default Credentials)
# ----------------------------------------------------------------
# Cách dùng ADC trên máy dev (không cần file JSON):
#   1. Cài Google Cloud CLI: https://cloud.google.com/sdk/docs/install
#   2. Chạy: gcloud auth application-default login
#   3. Đăng nhập bằng account có quyền trên project testtamlydata
#   4. ADC tự động được dùng — không cần set biến môi trường thêm
#
# Nếu dùng Service Account JSON thay thế (chỉ khi không dùng ADC):
#   GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# ================================================================
